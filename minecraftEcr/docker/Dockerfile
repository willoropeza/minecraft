ARG ITZG_IMAGE_TAG=2026.9.2-java25
FROM itzg/minecraft-server:${ITZG_IMAGE_TAG}
ARG MINECRAFT_VERSION
ENV EULA=TRUE \
    TYPE=VANILLA \
    VERSION=${MINECRAFT_VERSION} \
    MOTD="thirdechelon" \
    MODE=survival \
    DIFFICULTY=normal \
    MAX_PLAYERS=10 \
    VIEW_DISTANCE=10 \
    SIMULATION_DISTANCE=8 \
    ONLINE_MODE=TRUE \
    ENABLE_WHITELIST=TRUE \
    ENFORCE_WHITELIST=TRUE \
    WHITELIST="DopeEffect" \
    EXISTING_WHITELIST_FILE=MERGE \
    OPS="DopeEffect" \
    EXISTING_OPS_FILE=MERGE \
    USE_AIKAR_FLAGS=TRUE \
    STOP_DURATION=60

ENV ENABLE_AUTOSTOP=TRUE \
    AUTOSTOP_TIMEOUT_EST=1800 \
    AUTOSTOP_TIMEOUT_INIT=1800